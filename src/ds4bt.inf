;
; ds4bt.inf: Bluetooth DualShock 4 as a USB DualShock 4.
; Installs mshidkmdf as the HID minidriver on the DS4's HID collection, with ds4bt as its lower filter.
; Layout follows imbushuo/mac-precision-touchpad src/AmtPtpHidFilter/AmtPtpHidFilter.inf.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Provider%
CatalogFile = ds4bt.cat
DriverVer   = 10/03/2026,0.2.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[ControlFlags]
ExcludeFromSelect = *

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
ds4bt.sys = 1,,

[Manufacturer]
%Provider% = Models,NTamd64.10.0

; Check the exact ID in Device Manager > the DS4's "HID-compliant game controller" > Hardware Ids.
; A single-collection device has no &ColNN suffix; both forms are listed.
[Models.NTamd64.10.0]
%DeviceDesc% = Ds4Bt, HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0002054c_PID&05c4
%DeviceDesc% = Ds4Bt, HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0002054c_PID&05c4&Col01
%DeviceDesc% = Ds4Bt, HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0002054c_PID&09cc
%DeviceDesc% = Ds4Bt, HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0002054c_PID&09cc&Col01

[Ds4Bt.NT]
CopyFiles = Ds4Bt.CopyFiles

[Ds4Bt.CopyFiles]
ds4bt.sys

[Ds4Bt.NT.HW]
AddReg = Ds4Bt.AddReg

[Ds4Bt.AddReg]
HKR,,FriendlyName,,%DeviceDesc%
HKR,,"LowerFilters",0x00010008,"ds4bt"

[Ds4Bt.NT.Services]
AddService = ds4bt,, Ds4Bt.Service
AddService = mshidkmdf, 0x00000002, Mshidkmdf.Service    ; SPSVCINST_ASSOCSERVICE: function driver

[Ds4Bt.NT.Wdf]
KmdfService = ds4bt, Ds4Bt.Wdf

[Ds4Bt.Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Mshidkmdf.Service]
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %10%\System32\Drivers\mshidkmdf.sys

[Ds4Bt.Service]
DisplayName   = %SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\ds4bt.sys

[Strings]
Provider   = "ds4-driver"
DiskName   = "ds4bt install disk"
DeviceDesc = "DualShock 4 (Bluetooth, USB mode)"
SvcDesc    = "DualShock 4 Bluetooth USB-mode filter"
